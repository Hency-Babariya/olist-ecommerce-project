   "source": [
    "# ==========================================================\n",
    "# Question 9, Part 2: Has the negative review pattern changed over time?\n",
    "# \n",
    "# For the 5 worst-performing categories identified in Part 1, this builds\n",
    "# a quarterly heatmap of negative review rate (category x quarter).\n",
    "# \n",
    "# Design choices:\n",
    "# - Quarterly (not monthly) buckets, since monthly buckets left too many \n",
    "#   cells with unreliable sample sizes (< 20 reviews)\n",
    "# - Cells with fewer than 20 reviews in that quarter are masked (None) \n",
    "#   rather than shown as a misleading 0% or 100% rate\n",
    "# - Data trimmed to Q1 2017 onward, since Olist was still ramping up in \n",
    "#   late 2016 and most categories had too few reviews to be reliable yet\n",
    "# - Missing/masked cells render as pale red (#F7D9D9) instead of white,\n",
    "#   so \"no data\" is visually distinct from \"genuinely low negative rate\"\n",
    "# ==========================================================\n",
    "\n",
    "worst_categories = top10_worst.sort_values('negative_rate', ascending=False).head(5)['product_category_name'].tolist()\n",
    "\n",
    "trend_df = review_df[review_df['product_category_name'].isin(worst_categories)].copy()\n",
    "trend_df['order_quarter'] = trend_df['order_purchase_timestamp'].dt.to_period('Q').dt.to_timestamp()\n",
    "\n",
    "heatmap_summary = trend_df.groupby(['product_category_name', 'order_quarter']).agg(\n",
    "    negative_rate=('is_negative', 'mean'),\n",
    "    review_count=('review_score', 'count')\n",
    ").reset_index()\n",
    "\n",
    "heatmap_summary.loc[heatmap_summary['review_count'] < 20, 'negative_rate'] = None\n",
    "\n",
    "heatmap_summary_trimmed = heatmap_summary[heatmap_summary['order_quarter'] >= '2017-01-01']\n",
    "\n",
    "heatmap_pivot = heatmap_summary_trimmed.pivot(\n",
    "    index='product_category_name', columns='order_quarter', values='negative_rate'\n",
    ")\n",
    "\n",
    "fig2 = px.imshow(\n",
    "    heatmap_pivot,\n",
    "    color_continuous_scale='Reds',\n",
    "    labels=dict(x='Quarter', y='Product Category', color='Negative Review Rate'),\n",
    "    aspect='auto',\n",
    "    height=400\n",
    ")\n",
    "\n",
    "fig2.update_layout(\n",
    "    title='No category shows a steady worsening or improving trend — spikes are isolated to single quarters',\n",
    "    plot_bgcolor='#FFF6F3',\n",
    "    paper_bgcolor='white',\n",
    "    font=dict(family='Arial', size=12),\n",
    "    xaxis=dict(tickformat='%b %Y', showgrid=False),\n",
    "    yaxis=dict(showgrid=False),\n",
    "    title_font_size=15,\n",
    "    margin=dict(l=140, r=40, t=60, b=40)\n",
    ")\n",
    "fig2.update_coloraxes(colorbar_tickformat='.0%')\n",
    "fig2.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 45,
   "id": "0a7e8011-d4b0-4cf1-b441-c9cd64a8998a",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Question 10: How do order volumes vary by day-of-week, and does that affect delivery performance?"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 46,
   "id": "97b4d8d1-451c-4ded-b8fd-fb818122032a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "  day_of_week  order_count  avg_delay\n",
      "0      Monday        15703 -11.431352\n",
      "1     Tuesday        15502 -11.923093\n",
      "2   Wednesday        15074 -12.051215\n",
      "3    Thursday        14322 -12.158538\n",
      "4      Friday        13685 -11.874192\n",
      "5    Saturday        10556 -12.664629\n",
      "6      Sunday        11634 -12.518101\n"
     ]
    }
   ],
   "source": [
    "q10_df = df.dropna(subset=['order_purchase_timestamp', 'delivery_delay_days']).copy()\n",
    "q10_df['day_of_week'] = q10_df['order_purchase_timestamp'].dt.day_name()\n",
    "\n",
    "day_order = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']\n",
    "\n",
    "day_summary = q10_df.groupby('day_of_week').agg(\n",
    "    order_count=('order_id', 'nunique'),\n",
    "    avg_delay=('delivery_delay_days', 'mean')\n",
    ").reindex(day_order).reset_index()\n",
    "\n",
    "print(day_summary)"
   ]
  },

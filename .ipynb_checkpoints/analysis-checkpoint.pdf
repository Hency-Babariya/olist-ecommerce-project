   "source": [
    "weight_freight_df = df.dropna(subset=['product_weight_g', 'freight_value', 'cross_state']).copy()\n",
    "weight_freight_df['distance_group'] = weight_freight_df['cross_state'].map(\n",
    "    {True: 'Cross-state', False: 'In-state'}\n",
    ")\n",
    "\n",
    "# Remove extreme weight outliers\n",
    "weight_p99 = weight_freight_df['product_weight_g'].quantile(0.99)\n",
    "weight_freight_df = weight_freight_df[weight_freight_df['product_weight_g'] <= weight_p99]\n",
    "\n",
    "# Bin weight into 12 groups, then average freight cost per bin per distance group\n",
    "weight_freight_df['weight_bin'] = pd.cut(weight_freight_df['product_weight_g'], bins=12)\n",
    "weight_freight_df['weight_bin_mid'] = weight_freight_df['weight_bin'].apply(lambda x: x.mid)\n",
    "\n",
    "binned_summary = weight_freight_df.groupby(['weight_bin_mid', 'distance_group'], observed=True).agg(\n",
    "    avg_freight=('freight_value', 'mean'),\n",
    "    order_count=('freight_value', 'count')\n",
    ").reset_index()\n",
    "\n",
    "# Drop bins with too few orders to be reliable\n",
    "binned_summary = binned_summary[binned_summary['order_count'] >= 30]\n",
    "\n",
    "print(binned_summary)"
   ]
  },

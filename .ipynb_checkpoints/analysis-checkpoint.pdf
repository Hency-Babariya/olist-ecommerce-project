   "source": [
    "from plotly.subplots import make_subplots\n",
    "\n",
    "day_summary['avg_delay_display'] = -day_summary['avg_delay']  # flip sign: positive = days early\n",
    "\n",
    "# Build each trace using Express\n",
    "bar_fig = px.bar(\n",
    "    day_summary, x='day_of_week', y='order_count',\n",
    "    labels={'order_count': 'Order Volume', 'day_of_week': ''}\n",
    ")\n",
    "bar_fig.update_traces(marker_color='#2E75B6', name='Order Volume', showlegend=True)\n",
    "\n",
    "line_fig = px.line(\n",
    "    day_summary, x='day_of_week', y='avg_delay_display',\n",
    "    markers=True,\n",
    "    labels={'avg_delay_display': 'Avg Days Ahead of Estimate', 'day_of_week': ''}\n",
    ")\n",
    "line_fig.update_traces(line=dict(color='#2A9D8F', width=2.5), marker=dict(size=8),\n",
    "                        name='Avg Days Ahead of Estimate', showlegend=True)\n",
    "\n",
    "# Combine into one figure with two y-axes\n",
    "fig = make_subplots(specs=[[{\"secondary_y\": True}]])\n",
    "\n",
    "for trace in bar_fig.data:\n",
    "    fig.add_trace(trace, secondary_y=False)\n",
    "for trace in line_fig.data:\n",
    "    fig.add_trace(trace, secondary_y=True)\n",
    "\n",
    "fig.update_xaxes(categoryorder='array', categoryarray=day_order, showgrid=False)\n",
    "fig.update_yaxes(title_text='Order Volume', color='#2E75B6', gridcolor='#EEEEEE', secondary_y=False)\n",
    "fig.update_yaxes(title_text='Avg Days Ahead of Estimate', color='#2A9D8F', secondary_y=True)\n",
    "\n",
    "fig.update_layout(\n",
    "    title=dict(text='Weekend orders are less frequent but arrive with more buffer time',\n",
    "               font=dict(size=16), y=0.98, x=0.02, xanchor='left', yanchor='top'),\n",
    "    plot_bgcolor='white', paper_bgcolor='white',\n",
    "    font=dict(family='Arial', size=12),\n",
    "    margin=dict(l=60, r=60, t=100, b=40),\n",
    "    legend=dict(x=0.5, y=1.08, orientation='h', xanchor='center', yanchor='bottom')\n",
    ")\n",
    "fig.show()"
   ]
  }
 ],

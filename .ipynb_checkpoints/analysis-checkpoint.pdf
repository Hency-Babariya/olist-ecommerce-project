   "source": [
    "# Merge in review scores (order-level, so safe to merge)\n",
    "delay_df = df.merge(reviews[['order_id', 'review_score']], on='order_id', how='left')\n",
    "# Drop orders that were never delivered (can't calculate delay)\n",
    "delay_df = delay_df.dropna(subset=['delivery_delay_days'])\n",
    "# Aggregate: average delay and average review score per state\n",
    "state_summary = delay_df.groupby('customer_state').agg(\n",
    "    avg_delay=('delivery_delay_days', 'mean'),\n",
    "    avg_review=('review_score', 'mean'),\n",
    "    order_count=('order_id', 'nunique')\n",
    ").reset_index()\n",
    "# Keep only states with a reasonable number of orders (avoid noisy small samples)\n",
    "state_summary = state_summary[state_summary['order_count'] >= 30].sort_values('avg_delay', ascending=False)\n",
    "\n",
    "# NEW: only label states with enough volume to avoid clutter from tiny states\n",
    "state_summary['label'] = state_summary.apply(\n",
    "    lambda r: r['customer_state'] if r['order_count'] >= 300 else '', axis=1\n",
    ")\n",
    "\n",
    "print(state_summary)"
   ]
  },

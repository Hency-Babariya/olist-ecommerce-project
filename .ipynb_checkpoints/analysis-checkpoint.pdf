   "source": [
    "# Question 5: How does review score vary by product category, and is that pattern consistent regardless of delivery delay?"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 31,
   "id": "8133856a-272d-4161-a4dd-708c5b7ccab4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "     product_category_name      delay_group  avg_review  order_count\n",
      "0               automotivo  Early / On-time    4.244579         3518\n",
      "1               automotivo             Late    2.334471          273\n",
      "2             beleza_saude  Early / On-time    4.339395         7969\n",
      "3             beleza_saude             Late    2.289222          634\n",

   "source": [
    "fig = px.line(\n",
    "    monthly_summary,\n",
    "    x='order_month', y='avg_order_value',\n",
    "    color='product_category_name',\n",
    "    line_dash='group',  # top vs bottom get different dash styles as an extra visual cue\n",
    "    labels={\n",
    "        'order_month': 'Month',\n",
    "        'avg_order_value': 'Average Order Value (R$)',\n",
    "        'product_category_name': 'Category'\n",
    "    },\n",
    "    title='Top-selling categories keep stable prices; bottom-sellers swing more'\n",
    ")\n",
    "for trace in fig.data:\n",
    "    trace.update(\n",
    "        line=dict(width=1.5),\n",
    "        opacity=0.70\n",
    "    )\n",
    "fig.update_layout(\n",
    "    plot_bgcolor='white', paper_bgcolor='white',\n",
    "    font=dict(family='Arial', size=12),\n",
    "    xaxis=dict(gridcolor='#EEEEEE'),\n",
    "    yaxis=dict(gridcolor='#EEEEEE'),\n",
    "    title_font_size=16,\n",
    "    legend_title_text='Category'\n",
    ")\n",
    "fig.show()"
   ]
  },

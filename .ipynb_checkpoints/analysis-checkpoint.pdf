   "source": [
    "fig = go.Figure()\n",
    "\n",
    "fig.add_trace(go.Bar(\n",
    "    x=crossstate_summary['distance_group'], y=crossstate_summary['avg_delivery_days'],\n",
    "    name='Avg Delivery Time (days)', marker_color='#2E75B6',\n",
    "    yaxis='y1', offsetgroup=0\n",
    "))\n",
    "\n",
    "fig.add_trace(go.Bar(\n",
    "    x=crossstate_summary['distance_group'], y=crossstate_summary['avg_freight'],\n",
    "    name='Avg Freight Cost (BRL)', marker_color='#E63946',\n",
    "    yaxis='y2', offsetgroup=1\n",
    "))\n",
    "\n",
    "fig.update_traces(texttemplate='%{y:.1f}', textposition='outside')\n",
    "\n",
    "fig.update_layout(\n",
    "    title=dict(text='Cross-state orders take longer and cost more than in-state orders', \n",
    "               font=dict(size=16), y=0.98, x=0.02, xanchor='left', yanchor='top'),\n",
    "    plot_bgcolor='white', paper_bgcolor='white',\n",
    "    font=dict(family='Arial', size=12),\n",
    "    xaxis=dict(title='', showgrid=False),\n",
    "    yaxis=dict(\n",
    "        title=dict(text='Avg Delivery Time (days)', font=dict(color='#2E75B6')),\n",
    "        gridcolor='#EEEEEE',\n",
    "        tickfont=dict(color='#2E75B6')\n",
    "    ),\n",
    "    yaxis2=dict(\n",
    "        title=dict(text='Avg Freight Cost (BRL)', font=dict(color='#E63946')),\n",
    "        overlaying='y', side='right',\n",
    "        tickfont=dict(color='#E63946')\n",
    "    ),\n",
    "    barmode='group',\n",
    "    margin=dict(l=60, r=60, t=100, b=40),   # more top margin\n",
    "    legend=dict(x=0.5, y=1.08, orientation='h', xanchor='center', yanchor='bottom')\n",
    ")\n",
    "\n",
    "fig.show()"
   ]
  },

   "outputs": [],
   "source": [
    "# Question 6: Which states face the highest shipping cost burden (freight value relative to product price)?"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 34,
   "id": "fc0bd72e-b91d-4bf6-9b51-9b8309c4b64a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "   customer_state  total_price  total_freight  order_count  freight_burden_pct\n",
      "21             RR      7829.43        2235.19           46           28.548566\n",
      "9              MA    122881.79       32290.33          747           26.277555\n",
      "20             RO     46964.03       11717.47          253           24.949882\n",
      "2              AM     22809.36        5656.54          148           24.799205\n",
      "16             PI     92167.70       22480.64          495           24.391018\n",
      "26             TO     56251.91       13450.60          280           23.911366\n",
      "24             SE     60954.60       14541.29          350           23.855935\n",
      "15             PE    271258.36       61923.56         1652           22.828259\n",
      "14             PB    123726.34       27641.72          536           22.341015\n",
      "0              AC     17059.44        3802.06           81           22.287133\n",
      "13             PA    184407.88       39881.05          975           21.626543\n",
      "19             RN     94554.55       20074.28          485           21.230369\n",
      "5              CE    239418.24       50350.54         1336           21.030369\n",
      "3              AP     13654.30        2863.09           68           20.968413\n",
      "1              AL     83110.36       16368.65          413           19.695078\n"
     ]
    }
   ],
   "source": [
    "state_freight_summary = df.groupby('customer_state').agg(\n",
    "    total_price=('price', 'sum'),\n",
    "    total_freight=('freight_value', 'sum'),\n",
    "    order_count=('order_id', 'nunique')\n",
    ").reset_index()\n",
    "\n",
    "state_freight_summary = state_freight_summary[state_freight_summary['order_count'] >= 30]\n",
    "\n",
    "# Freight burden = freight cost as a % of product price — higher = worse burden\n",
    "state_freight_summary['freight_burden_pct'] = (\n",
    "    state_freight_summary['total_freight'] / state_freight_summary['total_price'] * 100\n",
    ")\n",
    "\n",
    "top15_burden = state_freight_summary.sort_values('freight_burden_pct', ascending=False).head(15)\n",
    "print(top15_burden)"
   ]
  },

     "text": [
      "                             count        mean         std    min      25%  \\\n",
      "payment_type payment_mode                                                    \n",
      "boleto       One-time      21835.0  128.392343   96.307072  11.62  58.1000   \n",
      "credit_card  Installments  55142.0  157.866859  101.719419  20.03  81.2225   \n",

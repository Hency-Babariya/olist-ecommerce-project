   "source": [
    "# Aggregate by product category\n",
    "category_summary = df.groupby('product_category_name').agg(\n",
    "    total_revenue=('price', 'sum'),\n",
    "    total_freight=('freight_value', 'sum'),\n",
    "    item_count=('order_id', 'nunique')\n",
    ").reset_index()\n",
    "\n",
    "# Filter out tiny categories (avoid noisy ratios from categories with few sales)\n",
    "category_summary = category_summary[category_summary['item_count'] >= 30]\n",
    "\n",
    "# Compute the ratio: revenue generated per $1 of freight spent\n",
    "category_summary['revenue_per_freight'] = category_summary['total_revenue'] / category_summary['total_freight']\n",
    "\n",
    "# Keep only top 15 by this ratio\n",
    "top15 = category_summary.sort_values('revenue_per_freight', ascending=False).head(15)\n",
    "\n",
    "print(top15)"
   ]
  },

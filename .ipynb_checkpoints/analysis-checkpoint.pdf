    "# Check missing values\n",
    "print(\"Missing values per column:\")\n",
    "print(df.isnull().sum()[df.isnull().sum() > 0])\n",
    "\n",
    "# Convert date columns to actual datetime\n",
    "date_cols = ['order_purchase_timestamp', 'order_approved_at', \n",
    "             'order_delivered_carrier_date', 'order_delivered_customer_date', \n",
    "             'order_estimated_delivery_date', 'shipping_limit_date']\n",
    "\n",
    "for col in date_cols:\n",
    "    df[col] = pd.to_datetime(df[col])\n",
    "\n",
    "print(\"\\nDate columns converted successfully\")\n",
    "print(df[date_cols].dtypes)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "32782863-ce38-428e-a00e-d44f1e92d002",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "New columns created!\n",
      "   delivery_delay_days purchase_day_of_week  cross_state\n",
      "0                 -8.0               Monday        False\n",
      "1                 -8.0               Monday        False\n",
      "2                 -8.0               Monday        False\n",
      "3                 -6.0              Tuesday         True\n",
      "4                -18.0            Wednesday         True\n"
     ]
    }
   ],
   "source": [
    "# Delivery delay in days (actual delivery - estimated delivery)\n",
    "# Positive = late, Negative = early\n",
    "df['delivery_delay_days'] = (df['order_delivered_customer_date'] - df['order_estimated_delivery_date']).dt.days\n",
    "\n",
    "# Fill missing English category names with the Portuguese name as fallback\n",
    "df['product_category_name_english'] = df['product_category_name_english'].fillna(df['product_category_name'])\n",
    "\n",
    "# Day of week of purchase\n",
    "df['purchase_day_of_week'] = df['order_purchase_timestamp'].dt.day_name()\n",
    "\n",
    "# Cross-state flag: did the order ship from a different state than the customer?\n",
    "df['cross_state'] = df['customer_state'] != df['seller_state']\n",
    "\n",
    "print(\"New columns created!\")\n",
    "print(df[['delivery_delay_days', 'purchase_day_of_week', 'cross_state']].head())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "5fa5e541-d006-421e-8536-23d2f1a70c78",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Question 1: How does delivery delay vary across states, and does it correlate with review scores?"
   ]
  },
  {
   "cell_type": "code",

   "source": [
    "# ==========================================================\n",
    "# Question 9, Part 1: Which product categories receive the most negative reviews (score <= 2)?\n",
    "#\n",
    "# Design choices:\n",
    "# - Ranked by RATE (% of reviews that are negative), not raw count —\n",
    "#   a high-volume category will always rack up more negative reviews\n",
    "#   just by having more orders, so rate is the fair comparison\n",
    "# - Filtered to categories with >= 50 total reviews, so a category with\n",
    "#   only a handful of reviews can't rank #1 purely from small-sample noise\n",
    "# - Color scale (Reds) reinforces the ranking rather than encoding a\n",
    "#   separate variable — darker = worse\n",
    "# - Title states the actual worst category and its real negative rate,\n",
    "#   computed directly from the data rather than assumed\n",
    "# ==========================================================\n",
    "\n",
    "review_df = df.merge(\n",
    "    reviews[['order_id', 'review_score']],\n",
    "    on='order_id',\n",
    "    how='inner'\n",
    ")\n",
    "review_df['is_negative'] = review_df['review_score'] <= 2\n",
    "\n",
    "category_review_summary = (\n",
    "    review_df\n",
    "    .groupby('product_category_name')\n",
    "    .agg(\n",
    "        total_reviews=('review_score', 'count'),\n",
    "        negative_reviews=('is_negative', 'sum'),\n",
    "        negative_rate=('is_negative', 'mean')\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "category_review_summary = category_review_summary[\n",
    "    category_review_summary['total_reviews'] >= 50\n",
    "]\n",
    "\n",
    "top10_worst = (\n",
    "    category_review_summary\n",
    "    .sort_values('negative_rate', ascending=False)\n",
    "    .head(10)\n",
    ")\n",
    "\n",
    "print(\"Category Review Summary\")\n",
    "display(\n",
    "    top10_worst.assign(\n",
    "        negative_rate=(top10_worst['negative_rate']*100).round(2)\n",
    "    )\n",
    ")\n",
    "\n",
    "plot_df = top10_worst.sort_values(\"negative_rate\")\n",
    "worst = top10_worst.iloc[0]\n",
    "title = (\n",
    "    f\"{worst['product_category_name']} has the highest negative review rate \"\n",
    "    f\"({worst['negative_rate']*100:.1f}%)\"\n",
    ")\n",
    "\n",
    "fig1 = px.bar(\n",
    "    plot_df,\n",
    "    x=\"negative_rate\",\n",
    "    y=\"product_category_name\",\n",
    "    orientation=\"h\",\n",
    "    color=\"negative_rate\",\n",
    "    color_continuous_scale=\"Reds\",\n",
    "    text=plot_df[\"negative_rate\"].mul(100).round(1).astype(str) + \"%\",\n",
    "    labels={\n",
    "        \"negative_rate\": \"Negative Review Rate\",\n",
    "        \"product_category_name\": \"Product Category\"\n",
    "    },\n",
    "    title=title\n",
    ")\n",
    "fig1.update_traces(textposition=\"outside\")\n",
    "fig1.update_coloraxes(showscale=False)\n",
    "fig1.update_layout(\n",
    "    plot_bgcolor=\"white\",\n",
    "    paper_bgcolor=\"white\",\n",
    "    font=dict(family=\"Arial\", size=12),\n",
    "    title_font_size=16\n",
    ")\n",
    "fig1.update_xaxes(tickformat=\".0%\", gridcolor=\"#EEEEEE\")\n",
    "fig1.update_yaxes(gridcolor=\"#EEEEEE\")\n",
    "fig1.show()"
   ]
  },
  {

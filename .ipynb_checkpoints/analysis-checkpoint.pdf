   "source": [
    "fig = px.bar(\n",
    "    category_delay_summary,\n",
    "    x='product_category_name', y='avg_review',\n",
    "    color='delay_group',\n",
    "    barmode='group',\n",
    "    color_discrete_map={\n",
    "        'Early / On-time': '#DDDDDD',   # baseline — muted grey\n",
    "        'Late': '#6C9ECC'               # standout — this is the group the story is about\n",
    "    },\n",
    "    category_orders={'product_category_name': overall_order},\n",
    "    labels={\n",
    "        'product_category_name': 'Product Category',\n",
    "        'avg_review': 'Average Review Score',\n",
    "        'delay_group': ''\n",
    "    },\n",
    "    height=500\n",
    ")\n",
    "\n",
    "fig.update_layout(\n",
    "    title='Late deliveries drag down review scores consistently across nearly every top category',\n",
    "    plot_bgcolor='white', paper_bgcolor='white',\n",
    "    font=dict(family='Arial', size=12),\n",
    "    xaxis=dict(showgrid=False, tickangle=-30),\n",
    "    yaxis=dict(gridcolor='#EEEEEE', range=[0, 5]),\n",
    "    margin=dict(l=60, r=40, t=60, b=100)\n",
    ")\n",
    "fig.show()"
   ]
  },
  {
   "cell_type": "code",

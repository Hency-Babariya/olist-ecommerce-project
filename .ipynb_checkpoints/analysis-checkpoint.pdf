   "source": [
    "# Question 7: Does the relationship between product weight and freight cost differ by shipping distance (seller state → customer state)?"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 37,
   "id": "3229ac2b-cb4e-4062-98cb-815e0b80665f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "   weight_bin_mid distance_group  avg_freight  order_count\n",

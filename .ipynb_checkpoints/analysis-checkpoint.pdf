   "source": [
    "# Question 3: How has average order value trended over time, does the trend differ between top-selling vs. bottom-selling categories?"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "160a5931-b824-4cc0-8f54-90681d8abce6",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "  order_month   product_category_name  avg_order_value  order_count  \\\n",
      "0  2016-09-01            beleza_saude        44.990000            1   \n",
      "1  2016-10-01            beleza_saude        93.446200           44   \n",
      "2  2016-10-01         cama_mesa_banho        59.873750            5   \n",
      "3  2016-10-01           esporte_lazer       175.454737           19   \n",
      "4  2016-10-01  fashion_roupa_feminina        54.900000            1   \n",
      "5  2017-01-01            beleza_saude       171.485934           82   \n",
      "6  2017-01-01         cama_mesa_banho        81.999200           45   \n",
      "7  2017-01-01           esporte_lazer       123.083571           62   \n",
      "8  2017-01-01  fashion_roupa_feminina        38.650000            2   \n",
      "9  2017-01-01                  musica         9.900000            2   \n",
      "\n",
      "            group  \n",
      "0     Top-selling  \n",
      "1     Top-selling  \n",
      "2     Top-selling  \n",
      "3     Top-selling  \n",
      "4  Bottom-selling  \n",
      "5     Top-selling  \n",
      "6     Top-selling  \n",
      "7     Top-selling  \n",
      "8  Bottom-selling  \n",
      "9  Bottom-selling  \n"
     ]
    }
   ],
   "source": [
    "# Step 1: rank categories by order volume\n",
    "category_volume = df.groupby('product_category_name')['order_id'].nunique().sort_values(ascending=False)\n",
    "\n",
    "top3_categories = category_volume.head(3).index.tolist()\n",
    "bottom3_categories = category_volume[category_volume >= 30].tail(3).index.tolist()  # avoid near-zero noise categories\n",
    "selected_categories = top3_categories + bottom3_categories\n",
    "\n",
    "# Step 2: build monthly average order value per category\n",
    "trend_df = df[df['product_category_name'].isin(selected_categories)].copy()\n",
    "trend_df['order_month'] = trend_df['order_purchase_timestamp'].dt.to_period('M').dt.to_timestamp()\n",
    "\n",
    "monthly_summary = trend_df.groupby(['order_month', 'product_category_name']).agg(\n",
    "    avg_order_value=('price', 'mean'),\n",
    "    order_count=('order_id', 'nunique')\n",
    ").reset_index()\n",
    "\n",
    "# Step 3: label which group each category belongs to, for the legend\n",
    "monthly_summary['group'] = monthly_summary['product_category_name'].apply(\n",
    "    lambda c: 'Top-selling' if c in top3_categories else 'Bottom-selling'\n",
    ")\n",
    "\n",
    "print(monthly_summary.head(10))"
   ]
  },

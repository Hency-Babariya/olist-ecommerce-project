   ],
   "source": [
    "payment_df = df.dropna(subset=['payment_type', 'payment_installments', 'payment_value']).copy()\n",
    "payment_df['payment_mode'] = payment_df['payment_installments'].apply(\n",
    "    lambda x: 'One-time' if x == 1 else 'Installments'\n",
    ")\n",
    "\n",
    "# Filter out rare payment types so the chart isn't cluttered with near-empty boxes\n",
    "type_counts = payment_df['payment_type'].value_counts()\n",
    "common_types = type_counts[type_counts >= 100].index.tolist()\n",
    "payment_df = payment_df[payment_df['payment_type'].isin(common_types)]\n",
    "\n",
    "# Cap outliers at 95th percentile — always disclose this in the title\n",
    "p95 = payment_df['payment_value'].quantile(0.95)\n",
    "payment_df_cap = payment_df[payment_df['payment_value'] <= p95].copy()\n",
    "\n",
    "one_time_median = payment_df_cap.loc[payment_df_cap['payment_mode'] == 'One-time', 'payment_value'].median()\n",
    "installment_median = payment_df_cap.loc[payment_df_cap['payment_mode'] == 'Installments', 'payment_value'].median()\n",
    "\n",
    "print(payment_df_cap.groupby(['payment_type', 'payment_mode'])['payment_value'].describe())\n"
   ]
  },

   "source": [
    "fig = px.line(\n",
    "    binned_summary,\n",
    "    x='weight_bin_mid', y='avg_freight',\n",
    "    color='distance_group',\n",
    "    color_discrete_map={'In-state': '#2E75B6', 'Cross-state': '#E63946'},\n",
    "    markers=True,\n",
    "    hover_data={'order_count': True},\n",
    "    labels={\n",
    "        'weight_bin_mid': 'Product Weight (g)',\n",
    "        'avg_freight': 'Average Freight Cost (R$)',\n",
    "        'distance_group': ''\n",
    "    },\n",
    "    height=500\n",
    ")\n",
    "\n",
    "fig.update_traces(line=dict(width=2.5), marker=dict(size=8))\n",
    "\n",
    "fig.update_layout(\n",
    "    title=f'Cross-state shipments cost more at every weight — and the gap widens for heavier items (top 1% by weight excluded)',\n",
    "    plot_bgcolor='white', paper_bgcolor='white',\n",
    "    font=dict(family='Arial', size=12),\n",
    "    xaxis=dict(gridcolor='#EEEEEE'),\n",
    "    yaxis=dict(gridcolor='#EEEEEE'),\n",
    "    title_font_size=16,\n",
    "    margin=dict(l=60, r=40, t=60, b=40)\n",
    ")\n",
    "fig.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 39,
   "id": "a1b69310-b8dc-46cb-a659-e9b347c824e4",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Question 8: Do cross-state orders take longer or cost more than in-state orders?"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 40,
   "id": "be991b51-484a-429a-b372-7598594a8792",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "  distance_group  avg_delivery_days  avg_freight  order_count\n",
      "0    Cross-state          14.582125    23.683118        61899\n",
      "1       In-state           7.482481    13.466551        34824\n"
     ]
    }
   ],
   "source": [
    "crossstate_df = df.dropna(subset=['delivery_delay_days', 'freight_value', 'cross_state', \n",
    "                            'order_delivered_customer_date', 'order_purchase_timestamp']).copy()\n",
    "\n",
    "crossstate_df['distance_group'] = crossstate_df['cross_state'].map({True: 'Cross-state', False: 'In-state'})\n",
    "\n",
    "# Actual delivery time in days (purchase to delivery), not the delay vs. estimate\n",
    "crossstate_df['delivery_days'] = (crossstate_df['order_delivered_customer_date'] - crossstate_df['order_purchase_timestamp']).dt.days\n",
    "\n",
    "crossstate_summary = crossstate_df.groupby('distance_group').agg(\n",
    "    avg_delivery_days=('delivery_days', 'mean'),\n",
    "    avg_freight=('freight_value', 'mean'),\n",
    "    order_count=('order_id', 'nunique')\n",
    ").reset_index()\n",
    "\n",
    "print(crossstate_summary)\n"
   ]
  },
  {

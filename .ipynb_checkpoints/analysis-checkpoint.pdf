      "7          cama_mesa_banho             Late    2.196406          668\n",
      "8            esporte_lazer  Early / On-time    4.293364         6999\n",
      "9            esporte_lazer             Late    2.195167          487\n",
      "10  informatica_acessorios  Early / On-time    4.099812         6091\n",
      "11  informatica_acessorios             Late    2.313008          407\n",
      "12        moveis_decoracao  Early / On-time    4.076393         5820\n",
      "13        moveis_decoracao             Late    2.340314          440\n",
      "14      relogios_presentes  Early / On-time    4.215280         5057\n",
      "15      relogios_presentes             Late    2.158879          395\n",
      "16               telefonia  Early / On-time    4.116847         3782\n",
      "17               telefonia             Late    2.374214          287\n",
      "18   utilidades_domesticas  Early / On-time    4.214433         5409\n",
      "19   utilidades_domesticas             Late    2.214286          300\n"
     ]
    }
   ],
   "source": [
    "review_df = df.merge(reviews[['order_id', 'review_score']], on='order_id', how='left')\n",
    "review_df = review_df.dropna(subset=['review_score', 'delivery_delay_days'])\n",
    "\n",
    "# Group delivery delay into two simple buckets\n",
    "review_df['delay_group'] = review_df['delivery_delay_days'].apply(\n",
    "    lambda x: 'Early / On-time' if x <= 0 else 'Late'\n",
    ")\n",
    "\n",
    "# Keep only the top 10 categories by order volume, so the chart stays readable\n",
    "top_categories = df.groupby('product_category_name')['order_id'].nunique().sort_values(ascending=False).head(10).index.tolist()\n",
    "review_df = review_df[review_df['product_category_name'].isin(top_categories)]\n",
    "\n",
    "category_delay_summary = review_df.groupby(['product_category_name', 'delay_group']).agg(\n",
    "    avg_review=('review_score', 'mean'),\n",
    "    order_count=('order_id', 'nunique')\n",
    ").reset_index()\n",
    "\n",
    "# Sort category order by overall average review (not by delay group) for a clean axis order\n",
    "overall_order = review_df.groupby('product_category_name')['review_score'].mean().sort_values(ascending=False).index.tolist()\n",
    "\n",
    "print(category_delay_summary)\n"
   ]
  },

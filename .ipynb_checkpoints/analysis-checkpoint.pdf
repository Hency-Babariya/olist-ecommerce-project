    "fig = px.bar(\n",
    "    top15.sort_values('revenue_per_freight', ascending=True),\n",
    "    x='revenue_per_freight',\n",
    "    y='product_category_name',\n",
    "    orientation='h',\n",
    "    color='revenue_per_freight',\n",
    "    color_continuous_scale='Blues',\n",
    "    labels={\n",
    "        'revenue_per_freight': 'Revenue per $1 of Freight Cost',\n",
    "        'product_category_name': 'Product Category'\n",
    "    },\n",
    "    title='These 15 categories earn the most revenue per dollar of shipping cost'\n",
    ")\n",
    "\n",
    "fig.update_traces(\n",
    "    marker_line_width=0\n",
    ")\n",
    "\n",
    "fig.update_layout(\n",
    "    plot_bgcolor='white',\n",
    "    paper_bgcolor='white',\n",
    "    font=dict(family='Arial', size=12),\n",
    "    title_font_size=16,\n",
    "    coloraxis_showscale=False,\n",
    "    height=550,\n",
    "    bargap=0.20,    \n",
    "    xaxis=dict(\n",
    "        showgrid=True,\n",
    "        gridcolor='#EEEEEE',\n",
    "        zeroline=False\n",
    "    ),\n",
    "    yaxis=dict(\n",
    "        showgrid=True,\n",
    "        gridcolor='#EEEEEE',\n",
    "        categoryorder='total ascending',\n",
    "        tickfont=dict(color='#1f4e8c')\n",
    "    )\n",
    ")\n",
    "\n",
    "fig.show()"
   ]

   "source": [
    "fig = px.bar(\n",
    "    top15_burden.sort_values('freight_burden_pct', ascending=True),\n",
    "    x='freight_burden_pct',\n",
    "    y='customer_state',\n",
    "    orientation='h',\n",
    "    color='freight_burden_pct',\n",
    "    color_continuous_scale='Reds',   # confirm this line is actually here\n",
    "    labels={\n",
    "        'freight_burden_pct': 'Freight Cost as % of Product Price',\n",
    "        'customer_state': 'State'\n",
    "    },\n",
    "    height=500\n",
    ")\n",
    "\n",
    "fig.update_traces(marker_line_width=0)\n",
    "\n",
    "fig.update_layout(\n",
    "    title='Remote states pay a much steeper shipping tax relative to product price',\n",
    "    plot_bgcolor='white', paper_bgcolor='white',\n",
    "    font=dict(family='Arial', size=12),\n",
    "    xaxis=dict(\n",
    "        showgrid=True,\n",
    "        gridcolor='#EEEEEE',\n",
    "        zeroline=False\n",
    "    ),\n",
    "    yaxis=dict(\n",
    "        showgrid=True,\n",
    "        gridcolor='#EEEEEE',\n",
    "        tickfont=dict(color='#1f4e8c'),\n",
    "        categoryorder='total ascending'\n",
    "    ),\n",
    "    title_font_size=16,\n",
    "    coloraxis_showscale=False,\n",
    "    height=550,\n",
    "    bargap=0.20,\n",
    "    margin=dict(l=60, r=40, t=60, b=40)\n",
    ")\n",
    "fig.show()"
   ]
  },
